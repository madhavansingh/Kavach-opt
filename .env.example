# ==============================================================================
# Kavach-Opt Environment Configuration Template
# ==============================================================================
# Render automatically injects PORT (typically 10000 or dynamic).
# In local development without PORT, the server defaults to 3001.
PORT=10000

# Network interface host (0.0.0.0 required for Docker containers / Render)
HOST=0.0.0.0

# Optional override path to the compiled native C++ solver binary
# Defaults to auto-resolving in build-release/kavach-opt or build/kavach-opt
KAVACH_BIN_PATH=/app/build-release/kavach-opt

# Node environment mode
NODE_ENV=production
